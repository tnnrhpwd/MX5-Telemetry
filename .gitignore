# ============================================================================
# MX5-Telemetry Arduino Project .gitignore
# ============================================================================

# ============================================================================
# PlatformIO
# ============================================================================
.pio/
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch/
*.pio

# ============================================================================
# Arduino IDE
# ============================================================================
# Arduino build directories
build/
*.hex
*.eep
*.elf
*.lss
*.map
*.sym

# ============================================================================
# Arduino Libraries (installed via Library Manager)
# ============================================================================
# Don't ignore if you're vendoring libraries, but typically these are installed
# libraries/

# ============================================================================
# VS Code
# ============================================================================
.vscode/settings.json
.vscode/tasks.json
.vscode/extensions.json
.history/

# ============================================================================
# Local Environment Variables / Secrets
# ============================================================================
.env
.env.*
!.env.example
*.env.local
*.local.env
# Private keys and certificates (never commit key material)
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519

# ============================================================================
# Compiled Object Files
# ============================================================================
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll

# ============================================================================
# Temporary and Log Files
# ============================================================================
*.log
*.tmp
*.temp
*~
.DS_Store
Thumbs.db

# ============================================================================
# Crash / core dumps
# ============================================================================
hs_err_pid*.log
replay_pid*.log
/core
core.[0-9]*
*.dmp

# ============================================================================
# Java / Gradle (android/)
# ============================================================================
.gradle/
gradle-app.setting
*.class
*.hprof
# NOTE: android/gradle/wrapper/gradle-wrapper.jar is intentionally tracked.

# ============================================================================
# Local build output / install staging (not source)
# ============================================================================
dist/
android/build-mx5/

# Bookkeeping for scripts/push-hardware.ps1 (last commit pushed to each device)
.push-state.json

# ============================================================================
# Test Data and Logs (CSV files from SD card logging)
# ============================================================================
# Uncomment if you want to ignore CSV log files:
# *.csv
# LOG_*.CSV

# ============================================================================
# Python (pi/, tools/, scripts/, display/scripts/)
# ============================================================================
# Bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.Python
*.so
# Virtual environments (see also build-automation/venv/)
.venv/
venv/
env/
ENV/
.venv-*/
# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.hypothesis/
.tox/
.nox/
.cache/
# Packaging / install artifacts
*.egg
*.egg-info/
.eggs/
pip-wheel-metadata/
pip-log.txt
# Test / coverage output
.coverage
.coverage.*
coverage.xml
htmlcov/
nosetests.xml
# Notebook checkpoints
.ipynb_checkpoints/

# ============================================================================
# Wokwi Simulator
# ============================================================================
# Keep diagram.json and wokwi.toml, but ignore simulator state
.wokwi/

# ============================================================================
# System Files
# ============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ============================================================================
# Git Files
# ============================================================================
*.orig
*.rej

# ============================================================================
# Documentation Build Artifacts
# ============================================================================
docs/_build/
docs/.doctrees/

# ============================================================================
# IDE and Editor Files
# ============================================================================
.idea/
*.swp
*.swo
*~.nib
*.sublime-project
*.sublime-workspace
*.code-workspace
.vscode-test/
.clangd/
compile_commands.json

# ============================================================================
# Backup Files
# ============================================================================
*.bak
*.backup
*~

# ============================================================================
# ESP32-S3 Display Module
# ============================================================================
# Firmware backups (can be large, keep local only)
display/firmware_backup/

# ESP-IDF specific
sdkconfig
sdkconfig.old
managed_components/

# ESP32 firmware binaries
*.bin

# LVGL SquareLine Studio exports
display/ui/export/
*.si

# Build logs
display/build_log.txt
display/build_output.txt
display/build_stderr.txt
display/build_stdout.txt
display/full_build.log

# Temporary image conversion files
display/output-onlinepngtools.*

# User data files (persistent storage)
data/mpg_data.json
data/tpms_cache.json
# Auto-generated Flask signing key (web remote) - never commit
data/web_secret_key

# ============================================================================
# Real secrets (never commit - see pi/wpa_supplicant.conf.example and
# docs/guides/ENV_BACKUP_GUIDE.md for the encrypted backup/restore workflow)
# ============================================================================
pi/wpa_supplicant.conf
pi/.web-env
tools/lib/pi_config.json

# Local git filter-repo secret patterns (used to purge leaked credentials)
secrets-patterns.txt

# ============================================================================
# Local system backups/snapshots (installed packages, network dumps, etc.)
# Keep these on your own machine/drive, not in version control.
# ============================================================================
backups/

# ============================================================================
# Runtime state written by the Pi (e.g. state/led_settings.json, which restores the
# strip's settings after a restart). Machine-specific, never source.
# ============================================================================
state/
