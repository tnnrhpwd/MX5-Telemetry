<?xml version="1.0" encoding="utf-8"?>
<!-- MX5 Remote for Android Auto.

  Parked app, so the two declarations that matter are android:appCategory="game"
  on <application> and android.intent.category.CAR_LAUNCHER on the activity.

  usesCleartextTraffic is load bearing: the Pi serves plain HTTP on the USB tether,
  and API 28+ blocks cleartext by default, which would make every request fail with
  no obvious cause. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The Bluetooth fallback, used when the USB tether is not connected.

         Before Android 12 these were granted at install time; from 12 they moved into the
         "Nearby devices" runtime group, so the legacy pair is capped at API 30 and the new
         permission is declared separately. Asking for the wrong one for the wrong version
         is silently ignored, which looks like Bluetooth being broken.

         BLUETOOTH_SCAN is deliberately NOT requested. The Pi must be paired before either
         profile can be used, and connecting to an already-bonded device needs no scan, so
         the app never scans and never needs that permission. -->
    <uses-permission android:name="android.permission.BLUETOOTH"
                     android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
                     android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Optional per the car games guidance, and required=false because not every
         head unit or phone has one. OEMs read this to decide what to offer. -->
    <uses-feature android:name="android.hardware.gamepad"
                  android:required="false" />
    <application android:appCategory="game"
                 android:icon="@mipmap/ic_launcher"
                 android:roundIcon="@mipmap/ic_launcher_round"
                 android:label="MX5 Remote"
                 android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
                 android:usesCleartextTraffic="true">
        <!-- singleTop, NOT singleTask.

             Android Auto launches this with FLAG_ACTIVITY_NEW_TASK |
             FLAG_ACTIVITY_MULTIPLE_TASK | FLAG_ACTIVITY_CLEAR_TASK. singleTask allows one
             instance system-wide, which contradicts CLEAR_TASK, so the system resolved the
             conflict by destroying the instance and recreating it in a new task, over and
             over: the phone app vanished, the projected app never finished drawing, and
             each teardown closed the Bluetooth link the next launch then had to rebuild.

             singleTop gives the car screen its own instance in its own task and leaves
             the phone's instance alone. PiLink keeps the two sharing one PiClient.

             smallestScreenSize and uiMode are in configChanges because moving a task from
             the phone's display to the head unit changes both; without them that move is a
             configuration change and the activity is recreated anyway. -->
        <activity android:name=".MainActivity"
                  android:exported="true"
                  android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|uiMode|keyboardHidden|density"
                  android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- this line is what makes Android Auto list it -->
                <category android:name="android.intent.category.CAR_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The driving-category surface.

             The activity above is a parked "game", so the host greys it out as soon as
             the car moves. A CarAppService declaring androidx.car.app.category.DRIVING
             is the supported way to stay available in motion: the host renders the
             templates itself, so the content stays glanceable by construction.

             Both surfaces ship in one APK. The launcher entry above remains the parked
             dashboard; this service is what Android Auto offers while driving. -->
        <service android:name=".Mx5CarAppService"
                 android:exported="true">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.DRIVING" />
            </intent-filter>
        </service>
    </application>
</manifest>
