[Unit]
Description=MX5 Telemetry Display
# bluetooth.service is Wanted, not Required: a Pi with no working radio still boots and the
# display still works. The ordering is what matters - the adapter, and especially a USB
# dongle, can take seconds to appear, and losing that race used to leave the link down for
# the whole drive. BtLink now retries, so this is only the cheap half of the fix.
After=graphical.target bluetooth.service
Wants=graphical.target bluetooth.service

[Service]
Type=simple
User=pi
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/pi/.Xauthority
# Web remote auth token. Put MX5_WEB_TOKEN in /home/pi/MX5-Telemetry/pi/.web-env
# (gitignored) and uncomment the next line to enable phone access.
# EnvironmentFile=/home/pi/MX5-Telemetry/pi/.web-env
WorkingDirectory=/home/pi/MX5-Telemetry/pi/ui/src
# Kill any orphaned instances before starting (- prefix means ignore failures)
ExecStartPre=-/usr/bin/pkill -f 'python.*main.py'
# Wait for display/CAN to be ready
ExecStartPre=/bin/sleep 3
ExecStart=/usr/bin/python3 -u /home/pi/MX5-Telemetry/pi/ui/src/main.py --fullscreen
Restart=on-failure
RestartSec=10
# Ensure ALL child processes are killed on stop/restart
KillMode=control-group
# Timeout before SIGKILL
TimeoutStopSec=10

[Install]
WantedBy=graphical.target
