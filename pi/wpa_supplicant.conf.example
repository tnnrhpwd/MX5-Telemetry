ctrl_interface=DIR=/var/run/wpa_supplicant GROUP=netdev
update_config=1
country=US

# Phone hotspot - highest priority for testing/mobile use
network={
    ssid="YourPhoneHotspotName"
    psk="YourPhoneHotspotPassword"
    priority=15
}

# Home network 5GHz - high priority
network={
    ssid="YourHomeWiFi-5G"
    psk="YourHomeWiFiPassword"
    priority=10
}

# Home network 2.4GHz - fallback
network={
    ssid="YourHomeWiFi"
    psk="YourHomeWiFiPassword"
    priority=9
}
